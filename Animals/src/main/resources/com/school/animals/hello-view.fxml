<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.Canvas?>

<Pane xmlns:fx="http://javafx.com/fxml" fx:controller="com.school.animals.HelloController"
      prefWidth="600" prefHeight="450">

    <HBox spacing="5" layoutX="5" layoutY="10">
        <Button text="Bylinožravec" onAction="#addHerbivore"/>
        <Button text="Mäsožravec" onAction="#addCarnivore"/>
        <Button text="Zmeň smer mäsožravcov" onAction="#changeCarnivoreDirection"/>
        <Button text="Stop / Štart" onAction="#stopStart"/>
    </HBox>

    <Canvas fx:id="canvas" layoutX="0" layoutY="50" width="600" height="400"/>
</Pane>
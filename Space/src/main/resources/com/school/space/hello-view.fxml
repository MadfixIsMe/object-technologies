<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<Pane fx:id="root" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.school.space.HelloController"
      prefWidth="650" prefHeight="450">

    <HBox spacing="5" layoutX="5" layoutY="10">
        <Button text="Planéta" onAction="#pridajPlanetu"/>
        <Button text="Asteroid" onAction="#pridajAsteroid"/>
        <Button text="Satelit" onAction="#pridajSatelit"/>
        <Button text="Asteroidy červené" onAction="#asteroidyNaCerveno"/>
        <Button text="Satelity +20 doprava" onAction="#satelityDoprava"/>
    </HBox>
</Pane>